# All data processing runs locally. No paid services are required.
STATE_DIR=.state
AGENT_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
AGENT_MAX_TURNS=7
AGENT_TIMEOUT_SECONDS=90
# Deterministic runbook mode is available for repeatable evaluations: AGENT_MODE=runbook
NOTIFY_TO=joshuadominic747@gmail.com
# outbox captures email without credentials. gmail sends via your own OAuth client.
EMAIL_MODE=outbox
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional real daily forecast enrichment; synthetic shipments are always labelled.
WEATHER_LIVE=true
# Scheduler runs only while this process is alive, with restart catch-up for today.
DAILY_SCHEDULE_ENABLED=false
DAILY_HOUR_IST=7
# Set a fixed token or use the automatically generated .state/operator-token.
OPERATOR_TOKEN=
