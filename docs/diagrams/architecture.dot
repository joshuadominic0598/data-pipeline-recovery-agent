digraph VitalRoute {
  graph [bgcolor="#10151f", pad="0.4", ranksep="0.7", nodesep="0.45", fontname="Helvetica", label="VITALROUTE  /  RECOVERY AT A GLANCE", labelloc=t, fontsize=23, fontcolor="#d7e5f3", splines=ortho];
  node [shape=box, style="rounded,filled", fillcolor="#23352f", color="#4a7560", fontcolor="#c5edda", fontname="Helvetica", fontsize=15, margin="0.22,0.18", width=3.2];
  edge [color="#91a6bc", arrowsize=0.8, penwidth=1.6];
  trigger [label="01  Trigger a daily refresh\nHospital logistics + weather",fillcolor="#263449",color="#4d6689",fontcolor="#d3e1f4"];
  pipeline [label="02  Run the PySpark pipeline\nIngest → clean → rules → consumption"];
  agent [label="03  Investigate the failure\nRead evidence · propose a code patch",fillcolor="#363048",color="#756295",fontcolor="#ded0f4"];
  test [label="04  Test + check repair policy\nAutomatic if allowed; approval otherwise",fillcolor="#40382c",color="#8a704b",fontcolor="#f3d5a1"];
  release [label="05  Deploy + resume\nLocal Git release · reuse checkpoints"];
  verify [label="06  Verify + publish\nJob success AND all seven data checks"];
  stop [label="If tests fail or approval is rejected: stop recovery and retain the last trusted data.",fillcolor="#402e34",color="#80505c",fontcolor="#e5b9c3",fontsize=13];
  state [label="Persistent throughout: SQLite state + approvals + full trace + notification outbox",fillcolor="#263449",color="#4d6689",fontcolor="#d3e1f4",fontsize=13];
  {rank=same; trigger; pipeline; agent;}
  {rank=same; verify; release; test;}
  trigger -> pipeline -> agent;
  agent -> test;
  verify -> release -> test [style=invis];
  test -> release -> verify [constraint=false];
  test -> stop [style=dashed];
  verify -> state [style=dashed];
  {rank=same; stop; state;}
}
